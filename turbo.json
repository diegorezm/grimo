{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["cf-typegen"]
    },
    "test": {},
    "cf-typegen": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
