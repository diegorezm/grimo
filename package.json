{
  "name": "grimo",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@grimo/web --filter=@grimo/backend",
    "dev:backend": "pnpm --filter @grimo/backend dev",
    "dev:mobile": "pnpm --filter @grimo/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "seed": "pnpm --filter @grimo/backend seed",
    "tokens:generate": "pnpm --filter @grimo/tokens generate",
    "tokens:icons": "pnpm --filter @grimo/tokens icons",
    "deploy": "pnpm --filter @grimo/backend deploy && pnpm --filter @grimo/web build && pnpm --filter @grimo/web deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  }
}
