{
  "name": "grimo",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @grimo/web dev",
    "dev:api": "pnpm --filter @grimo/api-worker dev",
    "dev:mobile": "pnpm --filter @grimo/mobile start",
    "dev:server": "pnpm --filter @grimo/web build:static && pnpm --filter @grimo/server dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @grimo/db generate",
    "db:migrate": "pnpm --filter @grimo/api-worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @grimo/api-worker db:migrate:remote",
    "db:studio": "pnpm --filter @grimo/db studio",
    "tokens:generate": "pnpm --filter @grimo/tokens generate",
    "cf-typegen": "turbo run cf-typegen",
    "deploy": "turbo run deploy --filter=@grimo/api-worker --filter=@grimo/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  }
}
