{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Static SPA on Cloudflare (assets only, no worker). Data and auth live in Convex.
  "name": "grimo-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
