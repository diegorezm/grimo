# Copy to .env.local to point the web app at a Convex deployment.
# In dev this is optional: it defaults to the one `pnpm dev` (convex dev) runs.
VITE_CONVEX_URL=https://<deployment>.convex.cloud
# Production only: the public origin, for canonical URLs, sitemap.xml, og:image and JSON-LD (SEO).
# VITE_SITE_URL=https://grimo.app
# Optional: error monitoring (Sentry). Without the DSN nothing is sent.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>
# VITE_SENTRY_RELEASE=grimo-web@<git sha>
# Build only (shell env, not .env): uploads source maps, then deletes them from dist/.
# SENTRY_AUTH_TOKEN=... SENTRY_ORG=... SENTRY_PROJECT=...
