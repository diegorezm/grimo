{
  "expo": {
    "name": "Grimo",
    "slug": "grimo",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grimo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.morzen.grimo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFBF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.morzen.grimo"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#17121E",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Grimo usa suas fotos para você escolher a foto do perfil.",
          "cameraPermission": "O Grimo usa a câmera para tirar a foto do perfil e ler o código de barras dos livros."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Grimo usa a câmera para tirar a foto do perfil e ler o código de barras dos livros.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad3d12e1-d069-4abd-9a3b-6a8b3bd50280"
      }
    },
    "owner": "jeanpatricksm",
    "updates": {
      "url": "https://u.expo.dev/ad3d12e1-d069-4abd-9a3b-6a8b3bd50280"
    }
  }
}
