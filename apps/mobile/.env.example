# Copy to .env.local. Must point at the origin serving /api (web dev server or API worker).
# Physical device: your LAN IP (e.g. http://192.168.0.10:5173). Android emulator: http://10.0.2.2:5173
# Default server shown on the sign-in screen (users can switch to a self-hosted one).
EXPO_PUBLIC_API_URL=http://localhost:5173
