# Copy to .env.local. The Convex deployment the app talks to (packages/backend/.env.local has it).
# Cloud: https://<deployment>.convex.cloud
# Local deployment on a physical device: your LAN IP (e.g. http://192.168.0.10:3210).
# Android emulator: http://10.0.2.2:3210
EXPO_PUBLIC_CONVEX_URL=http://localhost:3210
# The web app (Terms, Privacy Policy and account deletion pages open there).
EXPO_PUBLIC_SITE_URL=http://localhost:5173
