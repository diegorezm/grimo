{
  "name": "@grimo/api-worker",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply grimo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply grimo-db --remote"
  },
  "dependencies": {
    "@grimo/api": "workspace:*",
    "@grimo/db": "workspace:*"
  },
  "devDependencies": {
    "@grimo/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
